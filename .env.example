# ── RL Web Automation Environment — API Keys ───────────────────────────────
# Copy this file to .env and fill in at least ONE key.
# The system auto-detects whichever key is present.

# ── FREE OPTIONS (no credit card required) ─────────────────────────────────

# 1. Google Gemini (RECOMMENDED - free, no expiry, no credit card)
#    Get key: https://aistudio.google.com → Get API Key
#    Run with: python main.py --agent gemini --episodes 5
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Groq — Llama 3.3 70B (free, 1000 req/day, very fast)
#    Get key: https://console.groq.com → API Keys
#    Run with: python main.py --agent groq --episodes 5
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenRouter (free tier: 50 req/day, many models)
#    Get key: https://openrouter.ai → Keys
#    Run with: python main.py --agent openrouter --episodes 5
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── PAID OPTION ────────────────────────────────────────────────────────────

# 4. Anthropic Claude (paid, ~$3/million tokens)
#    Get key: https://console.anthropic.com
#    Run with: python main.py --agent llm --episodes 5
ANTHROPIC_API_KEY=

# ── BROWSER SETTINGS (optional overrides) ─────────────────────────────────
# BROWSER_HEADLESS=true
# BROWSER_SLOW_MO=50
# BROWSER_TIMEOUT_MS=20000
